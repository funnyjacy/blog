---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE, UMAMI } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- SPA 模式:点击链接不整页跳转,后台换内容,不转圈不闪 -->
<ClientRouter />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="180x180" href={`${import.meta.env.BASE_URL}/favicon.png`.replace('//', '/')} />
<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`.replace('//', '/')} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}/sitemap-index.xml`.replace('//', '/')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="LZC7pm5hUT5bzwfi-LQVzgNpq-d160hCYX25VHvk7Tc" />

<!-- Umami 访问统计,配置了才加载 -->
{
	UMAMI.src && UMAMI.websiteId && (
		<script is:inline defer src={UMAMI.src} data-website-id={UMAMI.websiteId} />
	)
}

<Font cssVariable="--font-atkinson" preload />

<!-- 暗色模式:首屏前根据 localStorage / 系统偏好给 html 挂 .dark,避免闪白。
     SPA 导航(ClientRouter)换页后脚本不会重跑,靠 astro:after-swap 再应用一次 -->
<script is:inline>
	function applyThemeClass() {
		const theme =
			localStorage.getItem('theme') ??
			(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		document.documentElement.classList.toggle('dark', theme === 'dark');
	}
	applyThemeClass();
	document.addEventListener('astro:after-swap', applyThemeClass);
</script>

<!-- 导航高亮:构建时算死的 active class 在 SPA 换页后不适用(文章页不匹配任何导航),
     每次换页后按当前路径重算;文章页归"首页"名下(文章列表就在首页)。
     is:inline 保证每次换页都重新执行(Astro 会用 data-astro-rerun 语义处理) -->
<script is:inline data-astro-rerun>
	function updateActiveNav() {
		const norm = (p) => p.replace(/\/+$/, '') || '/';
		const path = norm(location.pathname);
		const isPost =
			/^\/blog\/.+/.test(location.pathname) &&
			!['/blog/about/', '/blog/music/', '/blog/search/'].some((p) =>
				location.pathname.startsWith(p),
			);
		// 文章页归"首页"名下;首页 href 带 base 前缀,归一化后是 '/blog'
		const homeHref = norm(document.querySelector('a[data-nav-href="/blog/"]')?.dataset.navHref ?? '');
		document.querySelectorAll('a[data-nav-href]').forEach((a) => {
			const href = norm(a.dataset.navHref ?? '');
			// 首页链接的 href 带 base 前缀(如 /blog/),归一化后是 '/blog' 不是 '/',
			// 与 Astro.url 算出来的 base 一致;文章页归它名下
			a.classList.toggle('active', path === href || (isPost && href === homeHref));
		});
	}
	updateActiveNav();
	document.addEventListener('astro:page-load', updateActiveNav);
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
