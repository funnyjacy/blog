---
// 顶部换页进度条(类似 antfu.me / GitHub 顶部那条):
// 点站内链接的瞬间在视口最顶端亮出一条,先窜到 15% 再慢慢爬,
// SPA 换页完成后冲到 100% 再淡出。
// 纯原生,无依赖;仅拦截 ClientRouter 的 SPA 换页,不影响跨站链接。
---

<div id="nav-progress" aria-hidden="true">
	<div class="nav-progress-bar"></div>
</div>

<script is:inline>
	(function () {
		// 本脚本在 <head> 里执行时 body 还没解析,#nav-progress 还不存在,
		// 必须等 DOM 就绪再取元素(不能像普通组件那样直接 document.getElementById)
		function init() {
			const root = document.getElementById('nav-progress');
			if (!root || root.dataset.ready) return;
			root.dataset.ready = '1';
			const bar = root.querySelector('.nav-progress-bar');
		const SHOW_DELAY = 250;
		let shown = false;
		let showTimer = null;
		let creepTimer = null;
		let finishTimer = null;
		let value = 0;

		function setValue(v) {
			value = v;
			bar.style.transform = 'scaleX(' + v + ')';
		}
		function start() {
			clearTimeout(finishTimer);
			clearTimeout(creepTimer);
			clearTimeout(showTimer);
			root.classList.remove('nav-progress-done');
			shown = false;
			// 先静默走到 15%,250ms 后才亮出来:预取让换页常常很快,
			// 太快时条一闪而过反而晃眼,只有真慢了才显示
			setValue(0.15);
			showTimer = setTimeout(function () {
				shown = true;
				root.classList.add('nav-progress-active');
				creep();
			}, SHOW_DELAY);
		}
		function creep() {
			if (!shown) return;
			// 慢慢逼近 90%,永远到不了 100(等换页真完成)
			value += (0.9 - value) * 0.08;
			setValue(value);
			creepTimer = setTimeout(creep, 220);
		}
		function finish() {
			clearTimeout(creepTimer);
			clearTimeout(showTimer);
			if (!shown) return; // 没亮过就直接结束,不闪一下
			shown = false;
			setValue(1);
			root.classList.add('nav-progress-done');
			finishTimer = setTimeout(function () {
				root.classList.remove('nav-progress-active', 'nav-progress-done');
				setValue(0);
			}, 300);
		}

		// 点到站内链接就起条(ClientRouter 会拦下同源链接,这里只判断同源)
		document.addEventListener(
			'click',
			function (e) {
				if (e.defaultPrevented || e.button !== 0) return;
				if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
				let link = e.target;
				if (link instanceof Element) link = link.closest('a');
				if (!(link instanceof HTMLAnchorElement)) return;
				if (link.target && link.target !== '_self') return;
				if (link.hasAttribute('download')) return;
				const url = new URL(link.href, location.href);
				if (url.origin !== location.origin) return;
				start();
			},
			true,
		);

		// 换页完成:先冲满再淡出
		document.addEventListener('astro:page-load', finish);
		// 用户点了浏览器后退/前进等也收尾
		window.addEventListener('popstate', start);
		}

		// <head> 里执行时 body 未解析;SPA 换页后组件节点会重建,也要重新 init
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
		document.addEventListener('astro:page-load', init);
	})();
</script>

<style>
	#nav-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 100;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	#nav-progress.nav-progress-active {
		opacity: 1;
	}
	.nav-progress-bar {
		height: 100%;
		width: 100%;
		/* 和选中文本的 ::selection 底色同一个变量(--accent) */
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition:
			transform 0.22s ease-out,
			opacity 0.3s ease;
	}
	#nav-progress.nav-progress-done .nav-progress-bar {
		opacity: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		#nav-progress {
			display: none;
		}
	}
</style>
