---
// 顶部换页进度条(类似 GitHub/YouTube 顶部那条)。
// 依次经历:点击 → 亮条并爬到 15% → 缓慢逼近 90% →
// 加载完成 → 快速冲到 100% → 停留 → 淡出。
// 纯原生,无依赖;仅拦站内同源链接,不影响外链/新标签页。
---
<div id="nav-progress" aria-hidden="true">
	<div class="nav-progress-bar"></div>
</div>

<script is:inline>
	(function () {
		if (window.__navProgressBound) return;
		window.__navProgressBound = true;

		// 关键:SPA 换页会整段替换 body,#nav-progress 是全新节点,
		// 新节点没有 active 类、transform 是 0。所以:
		//  1. 任何操作都现查 DOM,绝不缓存元素引用;
		//  2. 换页时在 astro:after-swap 把新条按当前进度立刻点亮,
		//     否则它会以"隐形"状态存在,finish() 冲到 100% 也看不见,
		//     表现就是"条走到一半、页面一变就没了"。
		const $root = () => document.getElementById('nav-progress');
		const $bar = () => {
			const r = $root();
			return r && r.querySelector('.nav-progress-bar');
		};

		const CREEP_MS = 200; // 缓慢爬升的步进间隔
		const RUSH_MS = 200; // 冲到 100% 的过渡时长(略大于 CSS 的 0.18s)
		const HOLD_MS = 400; // 满条停留,让人看清已经到头
		const FADE_MS = 280; // 淡出时长,与 CSS .nav-progress-done 一致
		// 起条后先静默这么久再显示:站点开了预取,大部分换页 200ms 内就完成,
		// 这种时候条一闪而过比不显示更烦人,只有真的慢了才亮出来
		const SHOW_DELAY = 250;

		let value = 0;
		let running = false;
		let shown = false; // 条是否已经亮出来过(没过 SHOW_DELAY 时为 false)
		let creepTimer = null;
		let showTimer = null;

		function write(v) {
			const b = $bar();
			if (b) b.style.transform = 'scaleX(' + v + ')';
		}
		function clearTimers() {
			clearTimeout(creepTimer);
			clearTimeout(showTimer);
			creepTimer = null;
			showTimer = null;
		}

		function start() {
			const r = $root();
			if (!r) return;
			clearTimers();
			r.classList.remove('nav-progress-done', 'nav-progress-active');
			running = true;
			shown = false;
			value = 0.15;
			write(value);
			// 延迟之后才点亮并开始爬;真快速换页时 finish 会先到,条从头到尾不出现
			showTimer = setTimeout(() => {
				showTimer = null;
				if (!running) return;
				const cur = $root();
				if (cur) cur.classList.add('nav-progress-active');
				shown = true;
				const creep = () => {
					if (!running) return;
					// 逼近 90%,剩下的留给完成时的冲线
					value += (0.9 - value) * 0.12;
					write(value);
					creepTimer = setTimeout(creep, CREEP_MS);
				};
				creepTimer = setTimeout(creep, CREEP_MS);
			}, SHOW_DELAY);
		}

		// 换页把 DOM 换掉后,新条默认隐形。只有条已经亮出来过才接续点亮,
		// 否则(还没过 SHOW_DELAY)会在新页面上凭空闪一下。
		function revealCurrent() {
			if (!running || !shown) return;
			const r = $root();
			const b = $bar();
			if (!r || !b) return;
			r.classList.remove('nav-progress-done');
			r.classList.add('nav-progress-active');
			b.style.transition = 'none';
			b.style.transform = 'scaleX(' + value + ')';
			void b.offsetWidth; // 强制回流,让上面的瞬时值生效
			b.style.transition = ''; // 恢复 CSS 过渡,供后续冲线使用
		}

		function finish() {
			if (!running) return;
			running = false;
			clearTimers();
			// 没过 SHOW_DELAY 就加载完了:当作从未出现,什么都不做。
			// 此时条本来也是隐藏的,不需要清理,下次 start 会覆盖状态。
			if (!shown) {
				shown = false;
				value = 0;
				return;
			}
			shown = false;
			const r = $root();
			const b = $bar();
			if (!r || !b) return;
			// 新页面的条可能还没点亮(after-swap 没跑到就到这了),先补上
			r.classList.remove('nav-progress-done');
			r.classList.add('nav-progress-active');
			// 冲线:不管当前停在哪,都用过渡快速推到最右端
			b.style.transform = 'scaleX(1)';
			// 等冲线动画走完 + 停留,再淡出;否则条没到头就开始消失
			setTimeout(() => {
				const cur = $root();
				if (!cur) return;
				cur.classList.add('nav-progress-done');
				setTimeout(() => {
					const fin = $root();
					const finBar = $bar();
					if (fin) fin.classList.remove('nav-progress-active', 'nav-progress-done');
					if (finBar) {
						// 归零时关掉过渡,避免出现"倒着缩回去"的动画
						finBar.style.transition = 'none';
						finBar.style.transform = 'scaleX(0)';
						void finBar.offsetWidth;
						finBar.style.transition = '';
					}
					value = 0;
				}, FADE_MS);
			}, RUSH_MS + HOLD_MS);
		}

		document.addEventListener(
			'click',
			(e) => {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
				let link = e.target;
				if (link instanceof Element) link = link.closest('a');
				if (!(link instanceof HTMLAnchorElement)) return;
				if (link.target && link.target !== '_self') return;
				if (link.hasAttribute('download') || link.dataset.astroReload !== undefined) return;
				const url = new URL(link.href, location.href);
				if (url.origin !== location.origin) return;
				// 点当前页自己的导航不算跳转,起条只会闪一下
				if (url.pathname === location.pathname && url.search === location.search) return;
				start();
			},
			true,
		);

		// 新文档已就位、旧文档已移除:把条接续点亮
		document.addEventListener('astro:after-swap', revealCurrent);
		// 换页完成:冲线 → 停留 → 淡出(首屏加载也会触发,靠 running 挡掉)
		document.addEventListener('astro:page-load', finish);
		// 浏览器前进/后退同样走 SPA 换页流程,起条后由上面两个事件收尾
		window.addEventListener('popstate', () => start());
	})();
</script>

<style>
	#nav-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		/* 3px 更细,不抢眼;深色下也够辨识 */
		height: 3px;
		z-index: 100;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	#nav-progress.nav-progress-active {
		opacity: 1;
	}
	.nav-progress-bar {
		height: 100%;
		width: 100%;
		/* 和选中文本的 ::selection 底色同一个变量(--accent) */
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		transition:
			transform 0.18s linear,
			opacity 0.3s ease;
	}
	#nav-progress.nav-progress-done .nav-progress-bar {
		/* 淡出时长与 JS 里的 FADE_MS 一致(280ms) */
		transition: opacity 0.28s ease;
		opacity: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		#nav-progress {
			display: none;
		}
	}
</style>
