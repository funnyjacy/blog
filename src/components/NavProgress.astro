---
// 顶部换页进度条(类似 GitHub/YouTube 顶部那条):
// 点站内链接立即出现,先走到 15% 再缓慢逼近 90%,
// SPA 换页完成(astro:page-load)时冲到 100%,停顿一下再淡出。
// 纯原生,无依赖;仅拦站内同源链接,不影响外链/新标签页。
---
<div id="nav-progress" aria-hidden="true">
	<div class="nav-progress-bar"></div>
</div>

<script is:inline>
	(function () {
		if (window.__navProgressBound) return;
		window.__navProgressBound = true;

		// 关键:SPA 换页会整段替换 body,#nav-progress 是全新节点。
		// 所以任何操作都要现查 DOM,绝不缓存元素引用(缓存会导致
		// 换页后往已销毁的旧节点上写样式,页面上那条永远停在旧进度)。
		// 监听绑在 document/window 上,只绑一次,不随换页重复累积。
		const $root = () => document.getElementById('nav-progress');
		const $bar = () => {
			const r = $root();
			return r && r.querySelector('.nav-progress-bar');
		};

		const CREEP_MS = 200;
		const FINISH_MS = 320;
		let creepTimer = null;
		let finishTimer = null;
		let running = false;

		function setValue(v) {
			const b = $bar();
			if (b) b.style.transform = 'scaleX(' + v + ')';
		}
		function clearTimers() {
			clearTimeout(creepTimer);
			clearTimeout(finishTimer);
			creepTimer = finishTimer = null;
		}

		function start() {
			const r = $root();
			if (!r) return;
			clearTimers();
			r.classList.remove('nav-progress-done');
			r.classList.add('nav-progress-active');
			running = true;
			let value = 0.15;
			setValue(value);

			// 平滑逼近 90%,剩下的留给 finish 冲线
			const creep = () => {
				if (!running) return;
				value += (0.9 - value) * 0.12;
				setValue(value);
				creepTimer = setTimeout(creep, CREEP_MS);
			};
			creep();
		}

		function finish() {
			if (!running) return;
			running = false;
			clearTimers();
			const r = $root();
			if (!r) return;
			// 冲到最右端,表示加载完成
			setValue(1);
			r.classList.add('nav-progress-done');
			finishTimer = setTimeout(() => {
				const cur = $root();
				if (cur) cur.classList.remove('nav-progress-active', 'nav-progress-done');
				// 重置到 0 时先关掉过渡,避免条"倒着缩回去"被看见
				const b = $bar();
				if (b) {
					b.style.transition = 'none';
					b.style.transform = 'scaleX(0)';
					// 强制回流后再恢复过渡,否则下一轮起条没有动画
					void b.offsetWidth;
					b.style.transition = '';
				}
			}, FINISH_MS);
		}

		document.addEventListener(
			'click',
			(e) => {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
				let link = e.target;
				if (link instanceof Element) link = link.closest('a');
				if (!(link instanceof HTMLAnchorElement)) return;
				if (link.target && link.target !== '_self') return;
				if (link.hasAttribute('download') || link.dataset.astroReload !== undefined) return;
				const url = new URL(link.href, location.href);
				if (url.origin !== location.origin) return;
				// 同一个页面(点当前页的导航):ClientRouter 也会 swap,但很快,
				// 起条再收条会闪一下,直接不起
				if (url.pathname === location.pathname && url.search === location.search) return;
				start();
			},
			true,
		);

		// 换页完成(首屏加载也会触发,此时没起过条,finish 会被 running 挡掉)
		document.addEventListener('astro:page-load', finish);
		// 用户中途取消/后退:也收尾,避免条卡住
		window.addEventListener('popstate', () => finish());
	})();
</script>

<style>
	#nav-progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		z-index: 100;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	#nav-progress.nav-progress-active {
		opacity: 1;
	}
	.nav-progress-bar {
		height: 100%;
		width: 100%;
		/* 和选中文本的 ::selection 底色同一个变量(--accent) */
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: 0 50%;
		/* 冲线要快、爬升要稳:统一用短过渡,JS 那边控制节奏 */
		transition:
			transform 0.18s linear,
			opacity 0.3s ease;
	}
	#nav-progress.nav-progress-done .nav-progress-bar {
		opacity: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		#nav-progress {
			display: none;
		}
	}
</style>
