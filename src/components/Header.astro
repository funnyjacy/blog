---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import NavProgress from './NavProgress.astro';

// 所有链接必须拼上 base('/blog'),否则会跳到 io/xxx 404
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<header>
	<!-- 顶部换页进度条。必须放在 body 里(Header 在 body 内),不能进 BaseHead:
	     NavProgress 渲染一个 div,div 出现在 <head> 会让浏览器提前结束 head,
	     后面所有 meta/link(favicon、title 等)全部掉进 body,favicon 失效 -->
	<NavProgress />
	<nav>
		<h2>
			<a class="site-brand" href={base}>
				<img class="avatar" src={`${base}avatar.png`} alt="" width="28" height="28" />
				<span class="site-name">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={base}>首页</HeaderLink>
			<HeaderLink href={`${base}about/`}>关于</HeaderLink>
			<HeaderLink href={`${base}music/`}>音乐</HeaderLink>
			<HeaderLink href={`${base}message-board/`}>留言板</HeaderLink>
			<HeaderLink href={`${base}search/`}>搜索</HeaderLink>
		</div>
		<button id="theme-toggle" class="theme-toggle" aria-label="切换明暗模式">
			<svg class="icon-light" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
				<path
					fill="currentColor"
					d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12zm0-14a1 1 0 0 1-1-1V1a1 1 0 0 1 2 0v2a1 1 0 0 1-1 1zm0 18a1 1 0 0 1-1-1v-2a1 1 0 0 1 2 0v2a1 1 0 0 1-1 1zM4.22 5.64a1 1 0 0 1 1.42 0l1.41 1.42a1 1 0 0 1-1.41 1.41L4.22 7.05a1 1 0 0 1 0-1.41zM16.95 15.54a1 1 0 0 1 1.41 0l1.42 1.41a1 1 0 0 1-1.42 1.42l-1.41-1.42a1 1 0 0 1 0-1.41zM1 11h2a1 1 0 0 1 0 2H1a1 1 0 0 1 0-2zm20 0h2a1 1 0 0 1 0 2h-2a1 1 0 0 1 0-2zM4.22 18.36a1 1 0 0 1 0-1.41l1.42-1.42a1 1 0 1 1 1.41 1.42l-1.41 1.41a1 1 0 0 1-1.42 0zM16.95 8.46a1 1 0 0 1 0-1.41l1.41-1.42a1 1 0 0 1 1.42 1.42l-1.42 1.41a1 1 0 0 1-1.41 0z"
				></path>
			</svg>
			<svg class="icon-dark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
				<path
					fill="currentColor"
					d="M12.3 22a10.2 10.2 0 0 1-9.8-10A10.2 10.2 0 0 1 12.3 2c2.1 0 4 .6 5.6 1.7a1 1 0 0 1-.3 1.8 7 7 0 0 0-4.4 11.3 7 7 0 0 0 4.4 2.7 1 1 0 0 1 .3 1.8A10.1 10.1 0 0 1 12.3 22z"
				></path>
			</svg>
		</button>
	</nav>
</header>
<script>
	function applyTheme(dark: boolean) {
		document.documentElement.classList.toggle('dark', dark);
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	}

	// SPA 导航(ClientRouter)换页后 header 是全新 DOM,模块脚本只执行一次,
	// 旧监听随旧节点一起丢弃;astro:page-load 首载和每次换页都触发,
	// 给当前 #theme-toggle 重新绑监听(addEventListener 同函数引用不会重复绑)。
	function bindThemeToggle() {
		document.getElementById('theme-toggle')?.addEventListener('click', themeClick);
	}

	// 处理器提到模块顶层:每次 page-load 绑的是同一函数引用,不会重复绑
	function themeClick(e: Event) {
		const dark = !document.documentElement.classList.contains('dark');
		// 全屏温和渐变:用 View Transition 的默认交叉淡化(旧画面淡出、新画面淡入),
		// 不做任何 clip-path 扩散。不用逐属性 transition 是因为 background-image
		// (body 顶部的 linear-gradient)不可过渡,会瞬间跳变形成折线;且过渡结束
		// 摘 class 时整页重绘会让字体闪烁。VT 截图淡化没有这两个问题。
		// 不支持 VT 或系统开了减少动效:瞬间切换
		if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
			applyTheme(dark);
			return;
		}
		// 注:试过"先推 giscus 主题、延后 180ms 再启动 VT"来让跨域 iframe 参与渐变,
		// 结果是评论框抢在整页之前变色,更难受,已回退。
		// giscus 是跨域 iframe,VT 快照抓不到它的实时画面,它的换色永远落在 VT 之后,
		// 所以它那一块是"渐变结束后突变"——这是 iframe + VT 的固有限制,接受现状。
		document.startViewTransition(() => applyTheme(dark));
	}

	bindThemeToggle();
	document.addEventListener('astro:page-load', bindThemeToggle);
</script>

<style>
	/* 主题切换的全屏温和渐变:View Transition 默认的交叉淡化。
	   覆盖默认动画时长为 450ms ease;e 参数未用但保留签名与旧版一致 */
	:global(::view-transition-old(root)),
	:global(::view-transition-new(root)) {
		animation: none; /* 关掉各自的默认动画 */
		mix-blend-mode: normal;
	}
	:global(::view-transition-old(root)) {
		z-index: 1;
	}
	:global(::view-transition-new(root)) {
		z-index: 2;
		animation: theme-fade 450ms ease both;
	}
	@keyframes theme-fade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	header {
		margin: 0;
		padding: 0 1em;
		background: var(--header-bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		min-width: 0;
	}
	.site-brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
		/* 手机窄屏站名不许换行,防止 header 被挤成两三行高 */
		white-space: nowrap;
		min-width: 0;
	}
	/* 站名文字:空间不够时收缩成省略号,保证永远不会和右侧导航重叠 */
	.site-name {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.avatar {
		border-radius: 50%;
		display: block;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	/* 三列网格:左侧站名 / 中间链接 / 右侧主题按钮。

	   只在足够宽(≥820px)时启用;更窄的宽度三列放不下,网格会把站名挤成
	   省略号,那个区间退回上面的 flex space-between(不居中但不重叠) */
	@media (min-width: 820px) {
		nav {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		}
		nav > h2 {
			justify-self: start;
			min-width: 0;
		}
		nav > .theme-toggle {
			justify-self: end;
		}
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
		white-space: nowrap;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-toggle {
		border: none;
		background: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--gray-dark));
		display: flex;
		align-items: center;
		/* nav a 带 4px border-bottom(active 下划线占位),按钮补同宽透明边框,
		   两边内容区才落在同一中线上 */
		border-bottom: 4px solid transparent;
	}
	.theme-toggle svg {
		/* 中文字形墨迹比 em 框中心高约 1.4px(375px 视口实测),
		   图标按 em 框居中会显得偏低,上移 0.08em 补偿 */
		transform: translateY(-0.1em);
	}
	/* 明暗图标只在对应模式下显示 */
	.icon-dark {
		display: none;
	}
	:global(html.dark) .icon-dark {
		display: block;
	}
	:global(html.dark) .icon-light {
		display: none;
	}
	/* 手机窄屏:链接 padding 收窄、间距收紧,保证导航保持单行不换行。
	   360px(主流安卓)下贴边零余量,字体渲染稍宽就会和站名重叠,
	   所以这里进一步压字号/留白,320px 也放得下 */
	@media (max-width: 480px) {
		header {
			padding: 0 0.5em;
		}
		nav a {
			padding: 0.8em 0.2em;
			font-size: 0.88em;
		}
		.site-brand {
			font-size: 0.88em;
			gap: 0.35em;
		}
		.theme-toggle {
			padding: 0.3em;
		}
		.internal-links {
			display: flex;
			flex-wrap: nowrap;
		}
	}
</style>
