---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comment from '../components/Comment.astro';
// KaTeX 样式表:rehype-katex 只生成 HTML 结构,没有这个 CSS 公式排版会错乱
import 'katex/dist/katex.min.css';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: { slug: string; title: string };
	next?: { slug: string; title: string };
};

const { title, description, pubDate, updatedDate, heroImage, prev, next } = Astro.props;
// base 为 '/blog'(不带尾斜杠),拼文章链接时手动补 '/'
const base = import.meta.env.BASE_URL;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description ?? title} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 880px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			/* 正文图片默认缩到内容区的 80% 并居中(md 内容是 slotted,必须 :global 才能命中)。
			   md 里用 (class: align-left / align-right / full) 覆盖对齐和宽度 */
			.prose :global(img) {
				max-width: 80%;
				height: auto;
				display: block;
				margin: 1em auto;
			}
			.prose :global(img.align-left) {
				margin-left: 0;
				margin-right: auto;
			}
			.prose :global(img.align-right) {
				margin-left: auto;
				margin-right: 0;
			}
			.prose :global(img.full) {
				max-width: 100%;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				margin: 2em 0 0 0;
				padding: 0.8em 1em;
				background: rgb(var(--gray-light) / 40%);
				border-radius: 8px;
				color: rgb(var(--gray));
				font-size: 0.8em;
			}
			.description {
				margin: 0 0 1.5em 0;
				padding-left: 0.8em;
				border-left: 3px solid rgb(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 0.85em;
				line-height: 1.5;
			}
			/* 底部导航条:上一篇 / 所有文章 / 下一篇 */
			.post-nav {
				width: 880px;
				max-width: calc(100% - 2em);
				margin: 2.5em auto 0;
				padding: 1em 0 0;
				/* 三列 grid:两侧各占 1fr,中间列永远真正居中,不因两侧宽度不等被挤偏 */
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.nav-prev {
				justify-self: start;
			}
			.nav-next {
				justify-self: end;
			}
			.nav-home {
				justify-self: center;
			}
			.post-nav a {
				display: flex;
				align-items: center;
				gap: 0.6em;
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.post-nav a:hover {
				opacity: 0.7;
			}
			.nav-text {
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.nav-prev .nav-text {
				align-items: flex-start;
			}
			.nav-next .nav-text {
				align-items: flex-end;
				text-align: right;
			}
			.nav-label {
				font-size: 0.75em;
				color: rgb(var(--gray));
			}
			.nav-title {
				font-size: 0.9em;
				max-width: 22ch;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.nav-spacer {
				width: 2em;
			}
			.nav-home {
				font-size: 0.85em;
				color: rgb(var(--gray));
				white-space: nowrap;
			}
			/* 代码块容器 + 右上角复制按钮(JS 注入) */
			.prose :global(.pre-wrap) {
				position: relative;
			}
			.prose :global(.copy-btn) {
				position: absolute;
				top: 0.6em;
				right: 0.6em;
				padding: 0.25em 0.7em;
				font-size: 0.7em;
				color: rgb(var(--gray-dark));
				background: rgb(var(--gray-light) / 60%);
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				cursor: pointer;
				opacity: 0.5;
				transition: opacity 0.15s;
			}
			.prose :global(.copy-btn:hover) {
				opacity: 1;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article data-pagefind-body>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
						</div>
						<h1>{title}</h1>
						{description && <p class="description">{description}</p>}
						<hr />
					</div>
					<slot />
					<p class="last-updated-on">
						本文最后更新于 <FormattedDate date={updatedDate ?? pubDate} />
					</p>
					<nav class="post-nav">
						{prev ? (
							<a class="nav-prev" href={`${base}/${prev.slug}`} title={prev.title}>
								<span class="arrow">←</span>
								<span class="nav-text">
									<span class="nav-label">上一篇</span>
									<span class="nav-title">{prev.title}</span>
								</span>
			</a>
						) : (
							<span class="nav-spacer"></span>
						)}
						<a class="nav-home" href={`${base}/`}>所有文章</a>
						{next ? (
							<a class="nav-next" href={`${base}/${next.slug}`} title={next.title}>
								<span class="nav-text">
									<span class="nav-label">下一篇</span>
								<span class="nav-title">{next.title}</span>
								</span>
								<span class="arrow">→</span>
							</a>
						) : (
							<span class="nav-spacer"></span>
						)}
					</nav>
					<Comment />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// 代码块右上角复制按钮:纯原生 JS,给每个 pre 包一层定位容器并注入按钮
			for (const pre of document.querySelectorAll('.prose pre')) {
				const wrap = document.createElement('div');
				wrap.className = 'pre-wrap';
				pre.parentNode.insertBefore(wrap, pre);
				wrap.appendChild(pre);

				const btn = document.createElement('button');
				btn.className = 'copy-btn';
				btn.type = 'button';
				btn.textContent = 'Copy';
				btn.addEventListener('click', async () => {
					const ok = await copyText(pre.innerText);
					btn.textContent = ok ? '已复制' : '复制失败';
					setTimeout(() => (btn.textContent = 'Copy'), 1500);
				});
				wrap.appendChild(btn);
			}

			// 优先用 async Clipboard API,被拒(如 iframe/权限)时退回 execCommand 兜底
			async function copyText(text) {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.style.cssText = 'position:fixed;opacity:0';
					document.body.appendChild(ta);
					ta.select();
					const ok = document.execCommand('copy');
					ta.remove();
					return ok;
				}
			}
		</script>
	</body>
</html>
