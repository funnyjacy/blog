---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { execFileSync } from 'node:child_process';
import BlogPost from '../layouts/BlogPost.astro';

export async function getStaticPaths() {
	// post.filePath 形如 src/content/blog/xxx.md,可直接传给 git
	function gitModifiedTime(file: string): Date | undefined {
		if (!file) return undefined;
		try {
			const out = execFileSync('git', ['log', '-1', '--format=%cI', '--', file], {
				encoding: 'utf8',
			}).trim();
			return out ? new Date(out) : undefined;
		} catch {
			return undefined; // 无 git 历史时跳过
		}
	}

	const posts = await getCollection('blog');
	// 与首页列表相同的排序(新在前),用于推算上一篇/下一篇
	const sorted = [...posts].sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((p) => {
		const i = sorted.findIndex((q) => q.id === p.id);
		return {
			params: { slug: p.id },
			props: {
				post: p,
				modified: gitModifiedTime(p.filePath),
				prev: i < sorted.length - 1 ? sorted[i + 1] : undefined,
				next: i > 0 ? sorted[i - 1] : undefined,
			},
		};
	});
}
type Props = {
	post: CollectionEntry<'blog'>;
	modified?: Date;
	prev?: CollectionEntry<'blog'>;
	next?: CollectionEntry<'blog'>;
};

const { post, modified, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
	{...post.data}
	updatedDate={post.data.updatedDate ?? modified}
	prev={prev && { slug: prev.id, title: prev.data.title }}
	next={next && { slug: next.id, title: next.data.title }}
>
	<Content />
</BlogPost>
