---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// pagefind 在 npm run build 后生成索引,开发服务器(npm run dev)里本页不可用
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`搜索 - ${SITE_TITLE}`} description="全文搜索" />
		<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
	</head>
	<body data-pagefind-ignore>
		<Header />
		<main>
			<h1>搜索</h1>
			<div id="search"></div>
		</main>
		<Footer />
		<script is:inline src={`${base}pagefind/pagefind-ui.js`}></script>
		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				new PagefindUI({
		element: '#search',
		showSubResults: true,
		translations: { clear_search: '清空' },
	});
			});
		</script>
	</body>
</html>

<style>
	#search {
		margin-top: 1em;
	}
</style>
<style is:global>
	/* pagefind-ui 自带样式用硬编码灰字(#393939),暗色模式下对比度极低,
	   全部换成站点自己的灰阶变量。Pagefind 是运行时生成的 DOM,
	   scoped 样式带不上 scope 属性,必须 is:global。
	   其内部规则是三层 .svelte 类的高特异性选择器,直接覆盖组件根上的
	   颜色变量最稳 */
	.pagefind-ui {
		--pagefind-ui-text: rgb(var(--gray-dark));
		--pagefind-ui-primary: rgb(var(--gray-dark));
		/* 自带 #eeeeee 边框在白天背景下几乎看不见,用灰阶主色调半透明 */
		--pagefind-ui-border: rgba(var(--gray), 45%);
	}
	.pagefind-ui__result-title,
	.pagefind-ui__result-link,
	.pagefind-ui__result-excerpt {
		color: rgb(var(--gray-dark));
	}
	/* 摘要与结果计数行:pagefind 内部用 .svelte-x.svelte-x 双类特异性,
	   普通选择器压不过,只能 !important */
	.pagefind-ui__result-excerpt {
		font-size: 16px !important;
		color: rgb(var(--gray-dark));
	}
	.pagefind-ui__result .pagefind-ui__result-name,
	.pagefind-ui__message {
		font-size: 16px !important;
		color: rgb(var(--gray-dark));
	}
	/* 输入框背景在两种模式下都是纯白,框内文字/放大镜/清除按钮一律纯黑,
	   不跟随暗色主题(之前跟着 --pagefind-ui-text 变量变成浅灰,在白底上特别淡) */
	.pagefind-ui__search-input {
		color: #000;
	}
	.pagefind-ui__search-input::placeholder {
		color: #000;
		/* pagefind 默认 opacity .2,白底上淡到几乎看不见;其选择器带 .svelte
		   双类特异性,需 !important 压过 */
		opacity: 0.5 !important;
	}
	.pagefind-ui__form::before {
		/* 放大镜伪元素实际挂在 form 上(不是 input),底色;pagefind 带 .svelte
		   双类特异性,需 !important */
		background-color: #000 !important;
	}
	.pagefind-ui__search-clear {
		color: #000 !important;
		font-size: 16px !important;
	}
	.pagefind-ui__mark {
		background: rgba(255, 220, 0, 45%);
		color: inherit;
	}
</style>
