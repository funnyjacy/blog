---
// 音乐页:歌单数据在 src/data/songs.js,加歌/删歌改那里即可。
import BaseHead from '../components/BaseHead.astro';
import Comment from '../components/Comment.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import songs from '../data/songs.js';

---

<!doctype html>
<html lang="zh-CN" class="music">
	<head>
		<BaseHead title={`音乐 - ${SITE_TITLE}`} description={`歌单 - ${SITE_DESCRIPTION}`} />
		<!-- YouTube IFrame API:异步加载,加载完成后回调 window.onYouTubeIframeAPIReady -->
		<script is:inline src="https://www.youtube.com/iframe_api" async></script>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<h1>音乐</h1>
				<p class="tagline">隔着千里，也能在同一首歌里相遇</p>
			</div>
			<ul id="playlist" class="playlist">
				{
					songs.map((song, i) => (
						<li class="song" data-index={i} data-type={song.type} data-src={song.src} role="button" tabindex="0" aria-label={`播放 ${song.title} - ${song.artist}`}>
							<span class="song-index">
								<span class="index-num">{i + 1}</span>
							</span>
							{song.cover && (
								<img class="song-cover" src={song.cover} alt={`${song.title} 专辑封面`} width="44" height="44" loading="lazy" />
							)}
							<span class="song-title">{song.title}</span>
							<span class="song-artist">{song.artist}</span>
							{/* 正在播放时显示在时长左侧的跳动竖条 */}
							<span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="song-duration">{song.duration ?? ''}</span>
							<span class="song-added">{song.added ?? ''}</span>
						</li>
					))
				}
			</ul>
			<p class="source-note">
				歌曲来源自 YouTube，播放时可能会有广告，推荐安装
				<a href="https://adguard.com/" target="_blank" rel="noopener noreferrer">AdGuard</a>
				插件屏蔽。
			</p>
			<Comment />
		</main>
		<!-- YouTube 播放器挂载点:被 API 替换成隐藏 iframe,只出声不见画 -->
		<div id="yt-host" class="yt-host"></div>
		<!-- 全局底部播放栏:所有歌共用 -->
		<div id="player-bar" class="player-bar" hidden>
			<img id="bar-cover" class="bar-cover" alt="" width="40" height="40" />
			<div class="bar-info">
				<span id="now-playing" class="now-playing"></span>
				<div class="bar-controls">
					<button id="prev" aria-label="上一首">⏮</button>
					<button id="play-pause" aria-label="播放/暂停">▶</button>
					<button id="next" aria-label="下一首">⏭</button>
					<input id="seek" class="seek" type="range" min="0" max="1000" value="0" step="1" aria-label="播放进度" />
					<span id="time" class="time">0:00 / 0:00</span>
				</div>
			</div>
		</div>
		<Footer />
	</body>
</html>

<script>
	// SPA 导航(ClientRouter)下模块脚本整站只执行一次,所有状态和监听都活在
	// 模块作用域里;换页后旧 DOM 被销毁,这里的引用全部失效。
	// 做法:状态保留在模块级(离开音乐页不清空,回来还能接着播),
	// 但每次 astro:page-load 进音乐页时,把绑定重新挂到当前文档的节点上。
	declare global {
		interface Window {
			onYouTubeIframeAPIReady?: () => void;
			YT: typeof YT;
		}
	}

	// ---- 模块级状态(跨换页存活) ----
	let current = -1;
	let ytReady = false;
	let ytPlayer: YT.Player | null = null;
	let seeking = false;
	let timer: ReturnType<typeof setInterval> | null = null;
	// 换页后的新 DOM 引用,每次进音乐页重新赋值
	let items: HTMLElement[] = [];
	let playerBar: HTMLDivElement;
	let barCover: HTMLImageElement;
	let nowPlaying: HTMLSpanElement;
	let playPauseBtn: HTMLButtonElement;
	let seek: HTMLInputElement;
	let timeLabel: HTMLSpanElement;

	const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

	// YouTube IFrame API 就绪后创建隐藏播放器。回调只此一份(本脚本不重跑),
	// 就绪前 ytPlayer 是 null,playSong 里有"等就绪后自动播"的钩子兜底
	window.onYouTubeIframeAPIReady = () => {
		ytPlayer = new window.YT.Player('yt-host', {
			height: '1',
			width: '1',
			playerVars: { playsinline: 1 }
		});
		ytReady = true;
	};

	// 换页回到音乐页时,若 API 早已就绪但 ytPlayer 指向旧文档已销毁的 iframe,
	// 在新文档的 yt-host 上重建播放器;还活着则复用
	function ensurePlayer() {
		if (!ytReady) return;
		const host = document.getElementById('yt-host');
		if (ytPlayer && host?.tagName === 'IFRAME') {
			try {
				ytPlayer.getDuration();
				return; // 现有 player 还能用
			} catch {
				/* 旧 player 已死,落到重建 */
			}
		}
		ytPlayer = new window.YT.Player('yt-host', {
			height: '1',
			width: '1',
			playerVars: { playsinline: 1 }
		});
	}

	function getYtDuration(): number {
		try {
			return ytPlayer?.getDuration() || 0;
		} catch {
			return 0;
		}
	}
	function getYtTime(): number {
		try {
			return ytPlayer?.getCurrentTime() || 0;
		} catch {
			return 0;
		}
	}

	function isPaused(): boolean {
		if (current < 0) return true;
		const song = items[current].dataset;
		if (song.type === 'youtube') {
			try {
				return ytPlayer?.getPlayerState() !== 1; // 1 = PLAYING
			} catch {
				return true;
			}
		}
		return (document.getElementById('audio') as HTMLAudioElement).paused;
	}

	function curTime(): number {
		return items[current]?.dataset.type === 'youtube' ? getYtTime() : audio().currentTime;
	}
	function curDuration(): number {
		return items[current]?.dataset.type === 'youtube' ? getYtDuration() : audio().duration || 0;
	}
	function doSeek(sec: number) {
		if (items[current].dataset.type === 'youtube') ytPlayer?.seekTo(sec, true);
		else audio().currentTime = sec;
	}

	function audio(): HTMLAudioElement {
		let el = document.getElementById('audio') as HTMLAudioElement | null;
		if (!el) {
			el = document.createElement('audio');
			el.id = 'audio';
			el.addEventListener('ended', () => playNext());
			document.body.appendChild(el);
		}
		return el;
	}

	function playPause() {
		if (current < 0) return;
		if (isPaused()) {
			if (items[current].dataset.type === 'youtube') ytPlayer?.playVideo();
			else audio().play();
		} else {
			if (items[current].dataset.type === 'youtube') ytPlayer?.pauseVideo();
			else audio().pause();
		}
	}

	function playSong(index: number) {
		const item = items[index];
		if (!item) return;
		// 换歌前先停掉旧的,清理上一首的高亮
		try {
			ytPlayer?.stopVideo();
		} catch {
			/* 尚未就绪 */
		}
		audio().pause();
		items.forEach((it) => it.classList.remove('playing'));

		current = index;
		item.classList.add('playing');
		playerBar.hidden = false;

		const title = item.querySelector('.song-title')!.textContent;
		const artist = item.querySelector('.song-artist')!.textContent;
		nowPlaying.textContent = `${title} - ${artist}`;
		const cover = item.querySelector<HTMLImageElement>('.song-cover');
		barCover.src = cover?.src ?? '';
		barCover.hidden = !cover;

		if (item.dataset.type === 'youtube') {
			if (!ytReady) {
				// API 还没加载完:挂一个等就绪后自动播的钩子
				const old = window.onYouTubeIframeAPIReady;
				window.onYouTubeIframeAPIReady = () => {
					old?.();
					if (current === index && item.dataset.type === 'youtube') ytPlayer?.loadVideoById(item.dataset.src!);
				};
			} else {
				ytPlayer!.loadVideoById(item.dataset.src!);
			}
		} else {
			audio().src = item.dataset.src!;
			audio().play();
		}

		// 进度条刷新循环
		if (!timer) {
			timer = setInterval(() => {
				if (current < 0 || seeking) return;
				const d = curDuration();
				const t = curTime();
				if (d > 0) seek.value = String(Math.round((t / d) * 1000));
				timeLabel.textContent = `${fmt(t)} / ${fmt(d)}`;
				const paused = isPaused();
				playPauseBtn.textContent = paused ? '▶' : '⏸';
			}, 500);
		}
	}

	function playNext(offset = 1) {
		playSong((current + offset + items.length) % items.length);
	}

	// ---- 每次进音乐页执行的初始化:重新抓 DOM、绑事件 ----
	function initMusicPage() {
		// 不在音乐页(换到别的页面)时,若正在播则继续后台播,只解除高亮
		if (!document.getElementById('yt-host')) {
			if (current >= 0 && timer) return; // 还在播,保留状态继续刷进度
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
			return;
		}
		ensurePlayer();

		items = Array.from(document.querySelectorAll<HTMLElement>('.song'));
		playerBar = document.getElementById('player-bar') as HTMLDivElement;
		barCover = document.getElementById('bar-cover') as HTMLImageElement;
		nowPlaying = document.getElementById('now-playing') as HTMLSpanElement;
		playPauseBtn = document.getElementById('play-pause') as HTMLButtonElement;
		seek = document.getElementById('seek') as HTMLInputElement;
		timeLabel = document.getElementById('time') as HTMLSpanElement;

		items.forEach((item, i) => {
			const activate = () => {
				// 点正在播的歌 = 暂停/继续;点别的歌 = 切歌
				if (current === i) {
					playPause();
				} else {
					playSong(i);
				}
			};
			item.addEventListener('click', activate);
			item.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					activate();
				}
			});
		});

		playPauseBtn.addEventListener('click', playPause);
		document.getElementById('prev')?.addEventListener('click', () => playNext(-1));
		document.getElementById('next')?.addEventListener('click', () => playNext(1));

		// 进度条:拖动时不被刷新循环覆盖,松手才真正 seek
		seek.addEventListener('input', () => (seeking = true));
		seek.addEventListener('change', () => {
			const d = curDuration();
			if (d > 0) doSeek((Number(seek.value) / 1000) * d);
			seeking = false;
		});

		// 换页回来时正在播:恢复高亮和播放栏(条目顺序跨换页一致,按索引映射)
		if (current >= 0 && items[current]) {
			items[current].classList.add('playing');
			playerBar.hidden = false;
		}
	}

	document.addEventListener('astro:page-load', initMusicPage);
	initMusicPage();
</script>

<style>
	main {
		/* 全局 main 有 width:880px,这里上限必须同时限住宽度,
		   否则手机上 main 固定 720px 整页横向溢出 */
		max-width: min(720px, calc(100% - 2em));
		margin: 0 auto;
		padding: 0 1em 4em;
	}
	h1 {
		padding-top: 1.5em;
	}
	/* 标题 + 右侧小诗:桌面端同一行,诗句靠右;窄屏自动换到标题下方 */
	.page-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.4em 1.5em;
	}
	/* 标题用楷体。注意不能加粗:楷体没有粗体字重,浏览器会合成假粗,
	   笔画糊成一团反而像宋体;正常字重 + 大字号才是楷体的笔意 */
	.page-head h1 {
		margin: 0.15em 0 0;
		font-family: KaiTi, STKaiti, 'Kaiti SC', '楷体', serif;
		font-size: 2.6em;
		font-weight: 400;
		letter-spacing: 0.12em;
	}
	.tagline {
		margin: 0;
		font-family: SimSun, STSong, 'Songti SC', '宋体', serif;
		font-size: 0.9em;
		letter-spacing: 0.1em;
		color: rgb(var(--gray));
	}
	.source-note {
		color: rgb(var(--gray-dark));
		font-size: 0.85em;
		margin: 2em 0 0;
		padding-top: 1em;
		border-top: 1px solid rgba(var(--black), 8%);
	}
	.playlist {
		list-style: none;
		margin: 1.5em 0;
		padding: 0;
	}
	.song {
		display: flex;
		align-items: center;
		gap: 0.75em;
		padding: 0.7em 0.9em;
		border-radius: 8px;
		cursor: pointer;
		transition: background 0.15s;
	}
	.song:hover {
		background: rgba(var(--black), 6%);
	}
	.song-index {
		min-width: 1.5em;
		display: flex;
		justify-content: center;
		color: rgb(var(--gray-dark));
		font-variant-numeric: tabular-nums;
	}
	/* 均衡器竖条:在时长左侧,播放中显示(占固定宽度,不挤动其他内容) */
	.eq {
		display: none;
		align-items: flex-end;
		gap: 2px;
		height: 14px;
		width: 13px;
		flex-shrink: 0;
		/* 离时长远一点,落在歌手和时长之间的空档 */
		margin-right: 2em;
	}
	.eq i {
		width: 3px;
		background: var(--accent);
		animation: eq-bounce 1s ease-in-out infinite;
	}
	.eq i:nth-child(1) {
		height: 40%;
	}
	.eq i:nth-child(2) {
		height: 90%;
		animation-delay: 0.2s;
	}
	.eq i:nth-child(3) {
		height: 60%;
		animation-delay: 0.4s;
	}
	@keyframes eq-bounce {
		0%,
		100% {
			transform: scaleY(0.4);
		}
		50% {
			transform: scaleY(1);
		}
	}
	.song.playing .eq {
		display: flex;
	}
	.song.playing .song-title {
		color: var(--accent);
	}
	.song-cover {
		width: 44px;
		height: 44px;
		object-fit: cover;
		border-radius: 6px;
		display: block;
	}
	.song-title {
		font-weight: 600;
		/* 需求:歌名优先完整显示,空间不够时先省略歌手名。
		   做法:标题可收缩(shrink 1)但收缩量按比例分担,单靠 shrink 值
		   调不出"歌手先没"的效果(实测 0.02 与 100 的比例下标题根本不缩,
		   360px 下直接撑破 173px),改用 max-width 给标题硬上限:
		   标题最多占 60% 行宽,超长的部分截断,剩余空间留给歌手 */
		flex: 0 1 auto;
		max-width: 60%;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.song-added {
		color: rgb(var(--gray-dark));
		font-size: 0.85em;
		font-variant-numeric: tabular-nums;
		margin-left: 1em;
		/* 日期是整行里信息价值最低的一列:不压缩、不折行,空间紧时由下方
		   媒体查询直接隐藏,把宽度让给歌名和歌手 */
		flex-shrink: 0;
		white-space: nowrap;
	}
	.song-artist {
		color: rgb(var(--gray-dark));
		/* 歌手名承接被压缩的空间:歌名完整时占据剩余宽度,
		   歌名太长时先被压成省略号(信息优先级低于歌名) */
		flex: 1 1 auto;
		/* 歌手名也截断:标题占满后由它兜底省略,保证整行不超宽 */
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.song-duration {
		color: rgb(var(--gray-dark));
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
		white-space: nowrap;
	}
	/* 全局底部播放栏 */
	.player-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 0.8em;
		padding: 0.6em 1.2em;
		background: var(--header-bg);
		box-shadow: 0 -2px 8px rgba(var(--black), 10%);
	}
	.player-bar[hidden] {
		display: none;
	}
	.bar-cover {
		width: 40px;
		height: 40px;
		object-fit: cover;
		border-radius: 6px;
	}
	.bar-info {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.now-playing {
		font-weight: 600;
		font-size: 0.9em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 16em;
	}
	.bar-controls {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.bar-controls button {
		border: none;
		background: none;
		cursor: pointer;
		font-size: 1.1em;
		padding: 0.2em 0.4em;
		color: var(--black);
	}
	.seek {
		flex: 1;
		accent-color: var(--accent);
		cursor: pointer;
	}
	.time {
		color: rgb(var(--gray-dark));
		font-size: 0.85em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 640px) {
		.now-playing {
			max-width: 10em;
		}
		/* 窄屏隐藏添加日期列,标题+封面+时长才放得下一行 */
		.song-added {
			display: none;
		}
		/* 窄屏收紧行高:封面 36px + 更小的内边距,点击热区不再占一大条 */
		.song {
			padding: 0.4em 0.6em;
			gap: 0.6em;
		}
		.song-cover {
			width: 36px;
			height: 36px;
		}
	}
</style>

<style is:global>
	/* YouTube 挂载点:移出视口,只出声不见画(display:none 会导致某些浏览器不出声)。
	   样式必须挂在 id 上:YT API 创建播放器时会把 #yt-host 这个 div 整个
	   替换成 iframe,class 会丢而 id 保留;scoped 样式靠 data-astro-cid 属性
	   匹配,iframe 上没有这个属性,scoped 规则也落空 → 必须 is:global */
	#yt-host {
		position: absolute;
		left: -9999px;
		top: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
</style>
